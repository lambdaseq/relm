;; shadow-cljs configuration
{:deps true
 :dev-http {8080 "public"}
 :builds
 {:examples {:target     :browser
            :output-dir "public/js"
            :asset-path "/js"
            :modules    {:main {:entries [examples.main]}}}
  :test {:target :node-script
         :output-to "out/test.js"
         :main examples.test-runner/main}}}